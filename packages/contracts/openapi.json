  "components": {
    "schemas": {
      "City": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "london",
              "new-york",
              "paris",
              "berlin",
              "chicago"
            ],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "time_zone": {
            "type": "string",
            "title": "Time Zone"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "coverage": {
            "type": "string",
            "title": "Coverage",
            "default": "limited"
          },
          "limitation": {
            "type": "string",
            "title": "Limitation",
            "default": "Curated venue evidence; door-to-door wheelchair routes are not verified."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "time_zone",
          "latitude",
          "longitude",
          "district"
        ],
        "title": "City"
      },
      "EligiblePlace": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "city_id": {
            "type": "string",
            "enum": [
              "london",
              "new-york",
              "paris",
              "berlin",
              "chicago"
            ],
            "title": "City Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Facts"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues"
          },
          "venue_eligible": {
            "type": "boolean",
            "title": "Venue Eligible"
          }
        },
        "type": "object",
        "required": [
          "id",
          "city_id",
          "name",
          "category",
          "latitude",
          "longitude",
          "interests",
          "description",
          "facts",
          "source_url",
          "venue_eligible"
        ],
        "title": "EligiblePlace"
      },
      "EnvironmentResult": {
        "properties": {
          "weather": {
            "additionalProperties": true,
            "type": "object",
            "title": "Weather"
          },
          "transport": {
            "additionalProperties": true,
            "type": "object",
            "title": "Transport"
          },
          "knowledge": {
            "$ref": "#/components/schemas/KnowledgeResult"
          }
        },
        "type": "object",
        "required": [
          "weather",
          "transport",
          "knowledge"
        ],
        "title": "EnvironmentResult"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type",
            "default": "official_venue"
          },
          "claim": {
            "type": "string",
            "title": "Claim"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Updated At"
          },
          "rights": {
            "type": "string",
            "title": "Rights",
            "default": "Original factual summary; linked source retains its own copyright."
          },
          "transformation_version": {
            "type": "string",
            "title": "Transformation Version",
            "default": "manual-summary-v1"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_url",
          "title",
          "claim",
          "retrieved_at"
        ],
        "title": "Evidence"
      },
      "ExplanationResult": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "provider"
        ],
        "title": "ExplanationResult"
      },
      "Fact": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "limited",
              "inaccessible",
              "unknown"
            ],
            "title": "Status",
            "default": "unknown"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "conflict": {
            "type": "boolean",
            "title": "Conflict",
            "default": false
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "default": false
          },
          "conditions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conditions"
          }
        },
        "type": "object",
        "required": [
          "feature"
        ],
        "title": "Fact"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntentInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "IntentInput"
      },
      "Interest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "maxLength": 40,
            "title": "Kind",
            "default": "culture"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Interest"
      },
      "KnowledgeResult": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Passages"
          }
        },
        "type": "object",
        "required": [
          "status",
          "passages"
        ],
        "title": "KnowledgeResult"
      },
      "Leg": {
        "properties": {
          "from_id": {
            "type": "string",
            "title": "From Id"
          },
          "to_id": {
            "type": "string",
            "title": "To Id"
          },
          "status": {
            "type": "string",
            "const": "unknown",
            "title": "Status"
          },
