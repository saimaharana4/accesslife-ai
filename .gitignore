# Publish only the six maintained specifications; preserve references locally.
/ai/*
!/ai/prd.md
!/ai/Architecture.md
!/ai/rules.md
!/ai/phases.md
!/ai/design.md
!/ai/memory.md

# Credentials and local configuration. Keep the public placeholder template.
.env
.env.*
!.env.example
!.env.*.example
gcp_usage.txt
credentials*.json
*service-account*.json
*service_account*.json
application_default_credentials.json
client_secret*.json
*.pem
*.key
*.p12
*.pfx
.secrets/
.gcloud/

# JavaScript and Python build environments; dependency lockfiles stay tracked.
node_modules/
.next/
.turbo/
.vercel/
dist/
build/
out/
coverage/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/

# Terraform state and machine-specific values can contain secrets.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Data, models, exports and generated test artifacts.
/data/
/.data/
/models/
/backups/
/artifacts/
.cache/
.huggingface/
playwright-report/
test-results/
*.log
*.dump
*.sqlite
*.sqlite3

# Workstation files.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.tmp
