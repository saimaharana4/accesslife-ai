{
  "name": "taste-duel",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --filter web dev",
    "build": "corepack pnpm --filter web build",
    "typecheck": "corepack pnpm --filter web typecheck",
    "dev:prototype": "node scripts/dev-fixtures.mjs",
    "start:prototype": "node scripts/start-prototype.mjs",
    "test:prototype": "playwright test --config playwright.prototype.config.ts",
    "test:e2e": "playwright test",
    "contracts": "uv run --no-sync python scripts/export_contracts.py && openapi-typescript packages/contracts/openapi.json -o apps/web/src/lib/api/schema.d.ts && prettier --write apps/web/src/lib/api/schema.d.ts",
    "test:api-foundation": "uv run --no-sync python scripts/tasteduel_local.py test",
    "dev:fixtures": "node scripts/dev-fixtures.mjs",
    "test:fixtures": "playwright test --config playwright.fixtures.config.ts",
    "test:fixture-state": "node --experimental-strip-types --test apps/web/src/features/fixtures/*.test.ts",
    "dev:live": "node scripts/dev-live.mjs",
    "start:live": "node scripts/start-live.mjs",
    "test:web-integration": "playwright test --config playwright.live.config.ts",
    "test:web-contracts": "node --experimental-strip-types --test apps/web/src/lib/api/*.test.ts apps/web/src/features/gameplay/*.test.ts",
    "check:fixture-production": "node scripts/check-fixture-production.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "3.6.2"
  }
}
