{
  "name": "taste-duel",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --filter web dev",
    "build": "corepack pnpm --filter web build",
    "typecheck": "corepack pnpm --filter web typecheck",
    "dev:prototype": "corepack pnpm --filter web exec next dev --hostname 127.0.0.1 --port 3001",
    "start:prototype": "node scripts/start-prototype.mjs",
    "test:prototype": "playwright test --config playwright.prototype.config.ts",
    "test:e2e": "playwright test",
    "contracts": "openapi-typescript packages/contracts/openapi.json -o apps/web/src/lib/api/schema.d.ts && prettier --write apps/web/src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "3.6.2"
  }
}
