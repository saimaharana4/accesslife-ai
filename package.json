{
  "name": "accesslife",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "test:e2e": "playwright test",
    "contracts": "openapi-typescript packages/contracts/openapi.json -o apps/web/src/lib/api/schema.d.ts && prettier --write apps/web/src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "3.6.2"
  }
}
