# Documentation template only. No application consumes this file yet.
# Copy to .env locally after the relevant implementation phase exists.
# Never put real secrets in this example or NEXT_PUBLIC_* variables.

APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
API_AUDIENCE=replace-with-private-cloud-run-api-url
WORKER_INTERNAL_URL=replace-with-private-cloud-run-worker-url

GCP_PROJECT_ID=replace-with-agreed-gcp-project-id
GCP_REGION=asia-south1
VERTEX_AI_LOCATION=replace-with-supported-model-location
VERTEX_AI_MODEL=replace-with-verified-available-model-id
# Use Application Default Credentials locally and service identities on GCP.
# No downloaded service-account key file is required by the design.

CLOUD_SQL_CONNECTION_NAME=replace-with-project-region-instance
DATABASE_URL=postgresql+psycopg://replace-user:replace-password@localhost:5432/accesslife
GCS_DOCUMENTS_BUCKET=replace-with-private-documents-bucket
GCS_BACKUPS_BUCKET=replace-with-private-backups-bucket
ARTIFACT_REGISTRY_REPOSITORY=replace-with-accesslife-repository
CLOUD_TASKS_QUEUE=replace-with-accesslife-planning-queue
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=replace-with-task-invoker-service-account

QLOO_BASE_URL=replace-with-account-approved-qloo-api-origin
QLOO_API_KEY=replace-with-local-secret-or-secret-manager-reference
TASTE_PROVIDER=development
PLACES_PROVIDER=osm
WEATHER_PROVIDER=open_meteo
TRANSIT_PROVIDER_REGISTRY=replace-with-city-provider-configuration
GENERATION_PROVIDER=vertex_ai
TFL_API_KEY=replace-if-required
IDFM_API_KEY=replace-if-required
CTA_API_KEY=replace-if-required
VBB_API_KEY=replace-if-required
MTA_BUS_API_KEY=replace-if-required

CITY_IDS=london,new-york,paris,berlin,chicago
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=replace-with-reviewed-model-commit
EMBEDDING_DIMENSIONS=384
CORPUS_VERSION=replace-with-promoted-corpus-version
MAX_ACTIVE_PLANNING_RUNS=3
MAX_EXTERNAL_CALLS_PER_RUN=5
GLOBAL_EXTERNAL_CALL_LIMIT=12
TOOL_TIMEOUT_SECONDS=8
PLAN_DEADLINE_SECONDS=30
PLANNING_TASK_TIMEOUT_SECONDS=60
MAX_RAW_DOCUMENT_BYTES=20000000000
MAX_ACTIVE_CHUNKS=100000
MAX_RETAINED_TEXT_BYTES=500000000
SESSION_RETENTION_HOURS=24
PROJECT_BUDGET_USD=80
LOG_LEVEL=INFO

# Browser-visible values are public configuration only, never API secrets.
NEXT_PUBLIC_MAP_STYLE_URL=replace-with-licensed-tile-style-url
NEXT_PUBLIC_MAP_ATTRIBUTION=replace-with-required-provider-attribution
