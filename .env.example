# Local defaults. Copy to .env; never commit real credentials.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
API_AUDIENCE=
POSTGRES_PASSWORD=accesslife_local
DATABASE_URL=postgresql+psycopg://accesslife:accesslife_local@127.0.0.1:5432/accesslife
GCP_PROJECT_ID=project-bb13ecd8-9d67-408d-9a7
GCP_REGION=asia-south1
# Optional for direct Compose: C:/Users/<you>/AppData/Roaming/gcloud
# scripts/dev.ps1 discovers this directory; credentials are mounted read-only.
GCP_ADC_DIRECTORY=
GENERATION_PROVIDER=vertex_ai
GENERATION_FALLBACK=groq
VERTEX_AI_MODEL=gemini-3.8-flash
VERTEX_AI_LOCATION=global
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
TASTE_PROVIDER=development
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# Store real credentials in Secret Manager. Set references in ignored .env;
# never paste a secret payload into this file. References take precedence.
QLOO_API_KEY_SECRET=
GROQ_API_KEY_SECRET=
OPENAI_API_KEY_SECRET=
OLLAMA_API_KEY_SECRET=
TFL_API_KEY_SECRET=
IDFM_API_KEY_SECRET=
CTA_API_KEY_SECRET=
VBB_API_KEY_SECRET=
MTA_BUS_API_KEY_SECRET=
LIVE_PROVIDERS=true
TASK_BACKEND=postgres
TFL_API_KEY=
IDFM_API_KEY=
CTA_API_KEY=
VBB_API_KEY=
MTA_BUS_API_KEY=
SESSION_RETENTION_HOURS=24
PLAN_DEADLINE_SECONDS=30
MAX_ACTIVE_PLANNING_RUNS=3
EMBEDDING_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
# Later Cloud Tasks deployment; leave blank locally.
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=
WORKER_INTERNAL_URL=
INTERNAL_WORKER_TOKEN=

MAX_DAILY_MODEL_CALLS=100
MAX_DAILY_PLANNING_RUNS=200
QLOO_CACHE_ENABLED=true
