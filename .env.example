# Reference configuration only. Never put secret payloads in this file.
# Compose uses compose.tasteduel.env explicitly; this file is not auto-loaded.
# The default local stack has no external provider access.
TASTEDUEL_QLOO_ENABLED=false
TASTEDUEL_GENERATION_ENABLED=false
TASTEDUEL_DATABASE_MODE=local

# Optional server-only live mode: ADC plus Secret Manager version references.
# Production is configured by Terraform, not by copying this file.
TASTEDUEL_DATABASE_SECRET_VERSION=
TASTEDUEL_MIGRATION_DATABASE_SECRET_VERSION=
TASTEDUEL_QLOO_SECRET_VERSION=
TASTEDUEL_VERTEX_PROJECT=
TASTEDUEL_ADC_PATH=

# Web forwarding: private API URL and exact public app origin only.
# Cloud deployment uses IAM identity tokens; no browser API key is needed.
TASTEDUEL_API_URL=http://127.0.0.1:18005
TASTEDUEL_WEB_ORIGINS=http://127.0.0.1:13001
TASTEDUEL_CANONICAL_ORIGIN=http://127.0.0.1:13001
TASTEDUEL_ALLOW_LOCAL_HTTP=true
TASTEDUEL_API_IAM=false
